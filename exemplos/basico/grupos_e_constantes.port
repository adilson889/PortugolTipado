// Grupos e Constantes - Declaração múltipla e bloqueio de alteração
//
// Os grupos em chaves evitam repetir o tipo para varias variaveis.
// A palavra 'const' exige valor inicial e impede alteracao posterior.
//
// Isto nao e uma linguagem separada do C - e C real, so com sintaxe
// em portugues. Cada linha que escreve aqui vira C direto.

funcao inicio()
{
    inteiro { x = 10, y = 20, z = 30 }

    const inteiro {
        LARGURA = 800
        ALTURA = 600
    }

    const real PI = 3.14159

    escreva("Coordenadas 3D: (", x, ", ", y, ", ", z, ")\n")
    escreva("Resolucao da tela: ", LARGURA, "x", ALTURA, "\n")
    escreva("Constante PI: ", PI, "\n")
}

